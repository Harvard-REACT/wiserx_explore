<launch>
  <!-- Quadmap visualizations-->
  <group ns="tb3_1">
      <node pkg="wiserx_explore_lite" type="quadmap_viz_ros.py" respawn="false" name="quadmap_viz_ros" output="screen">
          <param name="robot_name" value="tb3_1"/>
      </node>
  </group>

  <group ns="tb3_2">
      <node pkg="wiserx_explore_lite" type="quadmap_viz_ros.py" respawn="false" name="quadmap_viz_ros" output="screen">
          <param name="robot_name" value="tb3_2"/>
      </node>
  </group>


  <group ns="tb3_3">
      <node pkg="wiserx_explore_lite" type="quadmap_viz_ros.py" respawn="false" name="quadmap_viz_ros" output="screen">
          <param name="robot_name" value="tb3_3"/>
      </node>
  </group>


</launch>
