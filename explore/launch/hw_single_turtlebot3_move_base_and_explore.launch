<launch>
  <arg name="model" default="$(env TURTLEBOT3_MODEL)" doc="model type [burger, waffle, waffle_pi]"/>
  <arg name="multi_robot_name" default="tb3_1"/>
  <arg name="multi_robot_id" default="1"/>
  <arg name="move_forward_only" default="true"/>
  <arg name="open_rviz" default="true"/>
  <arg name="enable_wsr" default="true"/>
   <arg name="use_real_sensor" default="true"/>
  <arg name="min_frontier_size"  default="1.0"/>
  <arg name="sensor_range"  default="3.0"/>
  <arg name="add_noise"  default="false"/>
  <arg name="debug_mocap_pose"  default="false"/>
  <arg name="xmin_val" default="0.0"/>
  <arg name="ymin_val" default="0.0"/>
  <arg name="xmax_val" default="0.0"/>
  <arg name="ymax_val" default="0.0"/>
  <arg name="map_resolution" default="0.2"/>
  <arg name="robot_initial_map_pose_x" default="0"/>
  <arg name="robot_initial_map_pose_y" default="0"/>
  <arg name="robot_speed" default="0.05"/>
  <arg name="hgrid_width" default="45"/>
  <arg name="hgrid_height" default="45"/>
  <arg name="measurement_interval" default="4"/>
  <arg name="log_file_path" default="/home/react-ws-1/catkin_ws/src/m-explore/explore/data/wiserx_data/"/>

    <!-- move_base -->
   <group ns="$(arg multi_robot_name)">
    <include file="$(find wiserx_explore_lite)/launch/hw_move_base_default.launch">
      <arg name="model" value="$(arg model)" />
      <arg name="move_forward_only" value="$(arg move_forward_only)"/>
      <arg name="robot_name"  value="$(arg multi_robot_name)"/>
    </include>
   </group>

  <!-- rviz -->
  <group if="$(arg open_rviz)"> 
    <node pkg="rviz" type="rviz" name="$(anon rviz)" required="true"
          args="-d $(find wiserx_explore_lite)/rviz/$(arg multi_robot_name)_navigation.rviz"/>
  </group>

  <!-- Start exploration -->
  <include file="$(find wiserx_explore_lite)/launch/explore.launch">
    <arg name="ns"  value="$(arg multi_robot_name)"/>
    <arg name="robot_id" value="$(arg multi_robot_id)"/>
    <arg name="use_WSR"  value="$(arg enable_wsr)"/>
    <arg name="use_sim"  value="false"/>
    <arg name="use_real_sensor"  value="$(arg use_real_sensor)"/>
    <arg name="min_frontier_size_val" value="$(arg min_frontier_size)"/>
    <arg name="sensor_range_val" value="$(arg sensor_range)"/>
    <arg name="robot_base_frame_for_gmapping" value="$(arg multi_robot_name)/base_footprint" />
    <arg name="add_noise"  value="$(arg add_noise)"/>
    <arg name="debug_mocap_pose"  value="$(arg debug_mocap_pose)"/>
    <arg name="xmin_val" value="$(arg xmin)"/>
    <arg name="ymin_val" value="$(arg ymin)"/>
    <arg name="xmax_val" value="$(arg xmax)"/>
    <arg name="ymax_val" value="$(arg ymax)"/>
    <arg name="map_resolution" value="$(arg map_resolution)"/>
    <arg name="robot_initial_map_pose_x" value="$(arg robot_initial_map_pose_x)"/>
    <arg name="robot_initial_map_pose_y" value="$(arg robot_initial_map_pose_y)"/>
    <arg name="robot_speed" value="$(arg robot_speed)"/>
    <arg name="hgrid_width"  value="$(arg hgrid_width)"/>
    <arg name="hgrid_height"  value="$(arg hgrid_height)"/>
    <arg name="measurement_interval"  value="$(arg measurement_interval)"/>
    <arg name="log_file_path" value="$(arg log_file_path)"/>
  </include>


</launch>
